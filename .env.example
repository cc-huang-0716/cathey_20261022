# Optional settings; the application works without keys or an .env file.
# To use these locally, pass --env-file .env to Uvicorn (requires python-dotenv),
# or use Docker Compose, which reads .env automatically.
PORT=8080
CACHE_TTL_SECONDS=300
HISTORY_CACHE_TTL_SECONDS=900
MAX_STALE_SECONDS=3600
UPSTREAM_TIMEOUT_SECONDS=12
UPSTREAM_FAILURE_BACKOFF_SECONDS=30
